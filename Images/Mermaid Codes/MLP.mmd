flowchart LR
  %% Input Layer
  subgraph InputLayer["Input Layer"]
        I1(("I1"))
        I2(("I2"))
        I3(("I3"))
  end

  %% Hidden Layer 1
  subgraph HiddenLayer1["Hidden Layer 1"]
        H1(("H1"))
        H2(("H2"))
        H3(("H3"))
        H4(("H4"))
  end

  %% Hidden Layer 2
  subgraph HiddenLayer2["Hidden Layer 2"]
        H5(("H5"))
        H6(("H6"))
        H7(("H7"))
        H8(("H8"))
  end

  %% Output Layer
  subgraph OutputLayer["Output Layer"]
        O1(("O1"))
        O2(("O2"))
  end

  %% Connections from Input to Hidden Layer 1
  I1 -- "Input 1" --> H1 & H2 & H3 & H4
  I2 -- "Input 2" --> H1 & H2 & H3 & H4
  I3 -- "Input 3" --> H1 & H2 & H3 & H4

  %% Connections from Hidden Layer 1 to Hidden Layer 2
  H1 & H2 & H3 & H4 -- "Activation" --> H5 & H6 & H7 & H8

  %% Connections from Hidden Layer 2 to Output Layer
  H5 & H6 & H7 & H8 -- "Activation" --> O1 & O2
